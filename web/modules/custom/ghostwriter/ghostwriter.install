<?php

/**
 * @file
 * Install and uninstall functions for the Ghostwriter module.
 */

declare(strict_types=1);

use Drupal\Core\StringTranslation\TranslatableMarkup;
use Drupal\ghostwriter\Sync\DataSync;

/**
 * Implements hook_install().
 */
function ghostwriter_install(bool $is_syncing): void {
  foreach (_ghostwriter_resource_plugins() as $config_name => $plugin_id) {
    $config = \Drupal::configFactory()->getEditable($config_name);
    $plugins = $config->get('plugins') ?? [];
    if (!in_array($plugin_id, array_column($plugins, 'id'), TRUE)) {
      $plugins[] = ['id' => $plugin_id, 'enabled' => TRUE, 'configuration' => []];
      $config->set('plugins', $plugins)->save();
    }
  }
  \Drupal::service('ghostwriter.sync')->sync();
}

/**
 * Implements hook_uninstall().
 */
function ghostwriter_uninstall(bool $is_syncing): void {
  foreach (_ghostwriter_resource_plugins() as $config_name => $plugin_id) {
    $config = \Drupal::configFactory()->getEditable($config_name);
    $plugins = array_filter($config->get('plugins') ?? [], fn(array $plugin): bool => $plugin['id'] !== $plugin_id);
    $config->set('plugins', array_values($plugins))->save();
  }
  $keys = ['ghostwriter.fetched_at', 'ghostwriter.source'];
  foreach (DataSync::FILES as $file) {
    array_push($keys, "ghostwriter.sha256.$file", "ghostwriter.etag.$file", "ghostwriter.last_modified.$file");
  }
  \Drupal::state()->deleteMultiple($keys);
  \Drupal::service('file_system')->deleteRecursive(DataSync::DIR);
}

/**
 * Moves saved scripts from config to content, before config import drops them.
 */
function ghostwriter_update_11001(): TranslatableMarkup {
  $config_factory = \Drupal::configFactory();
  $names = $config_factory->listAll('ghostwriter.script.');
  $scripts = array_map(fn(string $name): array => $config_factory->get($name)->getRawData(), $names);
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $update_manager->uninstallEntityType($update_manager->getEntityType('ghostwriter_script'));
  $update_manager->installEntityType(\Drupal::entityTypeManager()->getDefinition('ghostwriter_script'));
  $storage = \Drupal::entityTypeManager()->getStorage('ghostwriter_script');
  foreach ($scripts as $script) {
    $storage->create([
      'id' => $script['id'],
      'label' => $script['label'],
      'author' => $script['author'],
      'characters' => $script['characters'],
      'meta' => $script['meta'] ? [$script['meta']] : [],
    ])->save();
  }
  foreach ($names as $name) {
    $config_factory->getEditable($name)->delete();
  }
  return t('Moved @count saved scripts from config to content.', ['@count' => count($names)]);
}

/**
 * Resource plugin ids Ghostwriter registers, keyed by mcp_server config name.
 */
function _ghostwriter_resource_plugins(): array {
  return [
    'mcp_server.resource_template_providers' => 'ghostwriter_resources',
    'mcp_server.resource_providers' => 'ghostwriter_status',
  ];
}
