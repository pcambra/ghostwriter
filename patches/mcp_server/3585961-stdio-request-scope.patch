diff --git a/src/Transport/StdioRequestScope.php b/src/Transport/StdioRequestScope.php
new file mode 100644
index 0000000..7c5925c
--- /dev/null
+++ b/src/Transport/StdioRequestScope.php
@@ -0,0 +1,128 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\mcp_server\Transport;
+
+use Drupal\Component\Datetime\TimeInterface;
+use Drupal\Component\DependencyInjection\ContainerInterface;
+use Drupal\Component\Plugin\Discovery\CachedDiscoveryInterface;
+use Drupal\Core\Cache\CacheCollectorInterface;
+use Drupal\Core\Cache\CacheTagsChecksumInterface;
+use Drupal\Core\Cache\ChainedFastBackend;
+use Drupal\Core\Cache\MemoryBackend;
+use Drupal\Core\Config\CachedStorage;
+use Drupal\Core\Config\ConfigFactoryInterface;
+use Drupal\Core\Entity\EntityTypeManagerInterface;
+use Symfony\Component\HttpFoundation\RequestStack;
+use Symfony\Contracts\Service\ResetInterface;
+
+/**
+ * Gives each STDIO message the fresh memory and clock of a new web request.
+ *
+ * Services that keep other memory opt in with the mcp_server.request_scoped
+ * tag and Symfony's ResetInterface.
+ */
+final class StdioRequestScope {
+
+  /**
+   * Constructs the request scope.
+   *
+   * @param \Drupal\Component\DependencyInjection\ContainerInterface $container
+   *   The container whose instantiated services are reset.
+   * @param \Symfony\Component\HttpFoundation\RequestStack $requestStack
+   *   The request stack holding the request time.
+   * @param \Drupal\Component\Datetime\TimeInterface $time
+   *   The time service.
+   * @param list<string> $destructableServiceIds
+   *   Services core destructs when a request ends.
+   * @param list<string> $taggedServiceIds
+   *   Services tagged mcp_server.request_scoped.
+   */
+  public function __construct(
+    private readonly ContainerInterface $container,
+    private readonly RequestStack $requestStack,
+    private readonly TimeInterface $time,
+    private readonly array $destructableServiceIds,
+    private readonly array $taggedServiceIds,
+  ) {}
+
+  /**
+   * Ends the previous message's request and starts a new one.
+   */
+  public function restart(): void {
+    foreach ($this->initialized($this->destructableServiceIds) as $service) {
+      $service->destruct();
+    }
+    foreach ($this->initialized($this->container->getServiceIds()) as $service) {
+      self::reset($service);
+    }
+    foreach ($this->initialized($this->taggedServiceIds) as $service) {
+      assert($service instanceof ResetInterface);
+      $service->reset();
+    }
+    drupal_static_reset();
+    $server = $this->requestStack->getCurrentRequest()->server;
+    $server->set('REQUEST_TIME', $this->time->getCurrentTime());
+    $server->set('REQUEST_TIME_FLOAT', $this->time->getCurrentMicroTime());
+  }
+
+  /**
+   * Returns the already built services among the ids, once per object.
+   *
+   * @param list<string> $ids
+   *   Service ids.
+   *
+   * @return array<int, object>
+   *   The services, keyed by object id.
+   */
+  private function initialized(array $ids): array {
+    $services = [];
+    foreach (array_filter($ids, $this->container->initialized(...)) as $id) {
+      $service = $this->container->get($id);
+      $services[spl_object_id($service)] = $service;
+    }
+    return $services;
+  }
+
+  /**
+   * Drops what a core service type keeps in memory for the current request.
+   */
+  private static function reset(object $service): void {
+    if ($service instanceof CacheCollectorInterface
+      || $service instanceof CacheTagsChecksumInterface
+      || $service instanceof ChainedFastBackend
+      || $service instanceof ConfigFactoryInterface) {
+      $service->reset();
+    }
+    elseif ($service instanceof MemoryBackend) {
+      $service->deleteAll();
+    }
+    elseif ($service instanceof CachedStorage) {
+      $service->resetListCache();
+    }
+    elseif ($service instanceof CachedDiscoveryInterface && !$service instanceof EntityTypeManagerInterface) {
+      self::reloadDefinitions($service);
+    }
+  }
+
+  /**
+   * Drops a plugin manager's in-memory definitions, keeping its cache entry.
+   *
+   * Plugin managers have no reset-only method. useCaches(FALSE) empties the
+   * in-memory definitions (DefaultPluginManager::useCaches()), and
+   * useCaches(TRUE) turns caching back on. The next getDefinitions() then
+   * reads cache.discovery again, which a drush cr in another process rebuilt.
+   * clearCachedDefinitions() is not used: it also invalidates that cache
+   * entry, so discovery would search every module again on every message.
+   *
+   * entity_type.manager is excluded by the caller: its useCaches(FALSE) also
+   * drops every entity handler (EntityTypeManager::useCaches()), which would
+   * rebuild entity storages on every message.
+   */
+  private static function reloadDefinitions(CachedDiscoveryInterface $manager): void {
+    $manager->useCaches(FALSE);
+    $manager->useCaches(TRUE);
+  }
+
+}
